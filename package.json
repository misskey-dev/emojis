{
  "name": "@misskey-dev/emojis",
  "version": "16.0.0",
  "description": "A set of emojis and definitions intended for use in Misskey.",
  "main": "built/index.cjs",
  "module": "built/index.mjs",
  "types": "built/index.d.ts",
  "exports": {
    ".": {
      "import": "./built/index.mjs",
      "require": "./built/index.cjs",
      "types": "./built/index.d.ts"
    },
    "./emojilist.json": "./built/emojilist.json",
    "./regex": {
      "import": "./built/regex/index.mjs",
      "require": "./built/regex/index.cjs",
      "types": "./built/regex/index.d.ts"
    },
    "./indexes/*": {
      "import": "./built/indexes/*.mjs",
      "require": "./built/indexes/*.cjs",
      "types": "./built/indexes/*.d.ts"
    },
    "./indexes/*.json": "./built/indexes/*.json",
    "./fluent-emoji/*.png": "./built/fluent-emoji/*.png",
    "./twemoji/*.svg": "./built/twemoji/*.svg"
  },
  "type": "module",
  "scripts": {
    "build:def": "unbuild",
    "build": "tsx ./scripts/build.ts",
    "update-definitions": "tsx ./scripts/emojilist-indexes-updater/index.ts"
  },
  "author": "Misskey Project",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "files": [
    "built",
    "LICENSE-CODE",
    "LICENSE-FLUENT-EMOJI",
    "LICENSE-TWEMOJI"
  ],
  "devDependencies": {
    "@discordapp/twemoji": "^16.0.1",
    "@twemoji/parser": "^16.0.0",
    "@types/node": "^24.1.0",
    "cldr-annotations-derived-full": "^47.0.0",
    "cldr-annotations-full": "^47.0.0",
    "execa": "^9.6.0",
    "kuromojin": "^3.0.1",
    "sharp": "^0.34.3",
    "tiny-glob": "^0.2.9",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "unbuild": "^3.6.0",
    "wanakana": "^5.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
